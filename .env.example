# Bu dosyayi ".env" olarak kopyala ve degerleri doldur:
#   PowerShell: Copy-Item .env.example .env

# --- Hugging Face (ucretsiz, acik kaynak embedding) ---
# https://huggingface.co/settings/tokens  -> "Read" yetkisi yeterli
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model degistirirsen HF_EMBEDDING_DIM'i de degistir ve yeniden migrate + embed et.
#   intfloat/multilingual-e5-large -> 1024  (varsayilan, en iyi Turkce kalitesi)
#   intfloat/multilingual-e5-base  -> 768   (2x hizli, biraz daha dusuk kalite)
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large
HF_EMBEDDING_DIM=1024

# --- OpenAI (YALNIZCA cevap uretimi / chatbot) ---
# Bu tek ucretli bilesen. Bos birakirsan arama calismaya devam eder,
# yalnizca "Analiz" sekmesi devre disi kalir.
OPENAI_API_KEY=sk-proj-xxxxxxxx
# Key'in erisebildigi bir sohbet modeli.
OPENAI_CHAT_MODEL=gpt-4.1

# --- Supabase Postgres (pgvector) ---
# Supabase paneli: Project Settings > Database > Connection string
# DATABASE_URL = transaction pooler (port 6543) -> uygulama sorgulari
# DIRECT_URL   = direct connection (port 5432)  -> migration / DDL
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
